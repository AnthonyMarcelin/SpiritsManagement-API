{
  "name": "spiritsmanagement-api",
  "version": "0.1.0",
  "description": "Création d'une api pour a terme créer une appli de gestion de favoris de spiritueux, dont whisky en priorité.",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "dev": "node --watch index.js",
    "db:create": " node src/migrations/01.createTables.js",
    "db:seed": "node src/migrations/02.seedTables.js",
    "db:reset": "node src/migrations/01.createTables.js && node src/migrations/02.seedTables.js",
    "test_sequelize": "node src/database/client.js",
    "lint": "eslint . --fix",
    "format": "prettier --write \"**/*.{js,ts,json,md}\"",
    "test": "mocha --timeout 10000",
    "test:email": "mocha src/utils/nodemailer/tests/emailSimple.test.js --timeout 10000",
    "test:email-integration": "mocha src/utils/nodemailer/tests/emailIntegration.test.js --timeout 15000",
    "test:integration-simple": "mocha src/utils/nodemailer/tests/emailIntegrationSimple.test.js --timeout 15000"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AnthonyMarcelin/SpiritsManagement-API"
  },
  "keywords": [],
  "author": "Anthony Marcelin",
  "license": "ISC",
  "dependencies": {
    "argon2": "^0.43.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.1",
    "joi": "^17.13.3",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.1",
    "nodemailer": "^7.0.5",
    "pg": "^8.13.3",
    "sequelize": "^6.37.7"
  },
  "devDependencies": {
    "chai": "^5.2.1",
    "eslint": "^8.57.1",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.3",
    "mocha": "^11.7.1",
    "prettier": "^3.6.2",
    "sinon": "^21.0.0",
    "supertest": "^7.1.4"
  }
}
